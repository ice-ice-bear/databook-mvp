# Host MariaDB: use a designated TEST database, never a production database.
# compose.demo.yaml overrides these with an isolated disposable MariaDB.
DB_HOST=host.docker.internal
DB_PORT=3306
DB_NAME=databook_mvp_test
DB_USER=databook_mvp
DB_PASSWORD=replace-with-test-account-password

# Independent data source: mock | example_api | adobe. --csv overrides this.
DATA_PROVIDER=example_api
DATA_API_URL=http://example-api:8000/daily

# Adobe Analytics OAuth Server-to-Server (Developer Console).
# Fill these locally; tokens are fetched automatically and never stored on disk.
# Keep DATA_PROVIDER unchanged until adobe-check/adobe-preview have been verified.
ADOBE_CLIENT_ID=
ADOBE_CLIENT_SECRET=
ADOBE_SCOPES=
ADOBE_GLOBAL_COMPANY_ID=
ADOBE_REPORT_SUITE_ID=
# Copy timezoneZoneinfo returned by adobe-check; date boundaries use this suite, not KST.
ADOBE_REPORT_SUITE_TIMEZONE=
ADOBE_CHANNEL_DIMENSION=variables/marketingchannel
ADOBE_DEVICE_DIMENSION=variables/mobiledevicetype
ADOBE_METRIC_VISITS=metrics/visits
ADOBE_METRIC_PAGE_VIEWS=metrics/pageviews
ADOBE_METRIC_ORDERS=metrics/orders
ADOBE_METRIC_REVENUE_KRW=metrics/revenue
ADOBE_SEGMENT_ID=
# JSON: actual Adobe labels -> MVP values. Replace keys using adobe-preview results.
ADOBE_CHANNEL_MAP='{"Paid Search":"paid_search","Natural Search":"organic_search","Direct":"direct","Email":"email","Social Networks":"social"}'
ADOBE_DEVICE_MAP='{"Mobile Phone":"mobile","Other":"desktop","Tablet":"tablet"}'
# Example labels are not authoritative (especially Other != desktop in every suite).
# Enable only after mapping, totals, timezone, integer-KRW and daily coverage are confirmed.
ADOBE_MAPPING_CONFIRMED=false
# none | openai | gemini. Model must be accessible in your API account.
LLM_PROVIDER=none
LLM_MODEL=
OPENAI_API_KEY=
GEMINI_API_KEY=


# Optional initial OneDrive folder. Configure it in web settings after creating the synced folder.
# Saved web settings in work/onedrive.json take precedence, including an empty path.
# Leave blank to keep reports local. No Microsoft API credentials are needed.
# Example: /Users/YOUR_USER/Library/CloudStorage/OneDrive-Personal/Databook
ONEDRIVE_DIR=
